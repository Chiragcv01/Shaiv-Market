{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sm-admin",
      "destination": "/shell"
    },
    {
      "source": "/login",
      "destination": "/shell"
    },
    {
      "source": "/reviews",
      "destination": "/shell"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/book-free-consultation",
      "destination": "/book-intro-call",
      "permanent": true
    },
    {
      "source": "/embed/:slug",
      "destination": "/calculators/:slug",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:sub(post|page|category)-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/what-is-mutual-:slug*",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/sl-calculator",
      "destination": "/calculators",
      "permanent": true
    },
    {
      "source": "/sl-calculator/",
      "destination": "/calculators",
      "permanent": true
    },
    {
      "source": "/decoding-cryptocurrency-a-beginners-guide",
      "destination": "/goal-planner",
      "permanent": true
    },
    {
      "source": "/decoding-cryptocurrency-a-beginners-guide/",
      "destination": "/goal-planner",
      "permanent": true
    },
    {
      "source": "/sip-calculator",
      "destination": "/calculators/sip-calculator",
      "permanent": true
    },
    {
      "source": "/swp-calculator",
      "destination": "/calculators/swp-calculator",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/author/:path*",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    }
  ]
}
